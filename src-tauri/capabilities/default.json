{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "safevault-vault-allow",
      "description": "Allow vault encryption and credential commands",
      "commands": {
        "allow": [
          "vault_status",
          "vault_setup",
          "vault_unlock",
          "vault_lock",
          "list_credentials",
          "get_credential",
          "create_credential",
          "update_credential",
          "delete_credential"
        ]
      }
    }
  ]
}
